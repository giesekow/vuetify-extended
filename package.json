{
  "name": "vuetify-extended",
  "version": "1.0.1",
  "description": "A plugin to use vuetify in javascript mode",
  "scripts": {
    "test": "npm run test:csp && npm run test:cli",
    "test:csp": "node test/csp-lazy-code-editor.test.cjs",
    "test:cli": "npm run build && node test/cli/create-form.test.cjs && node test/cli/advanced-cli.test.cjs",
    "build": "npm run build-esm && npm run build-cjs",
    "build-esm": "npx tsc -p tsconfig.json && cp -r src/css lib/esm/",
    "build-cjs": "npx tsc -p tsconfig-cjs.json && cp -r src/css lib/cjs/",
    "prepublishOnly": "npm run build"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/katex": "^0.16.7",
    "@types/node": "^24.0.13",
    "vue": "^3.5.38",
    "vuetify": "^4.1.2",
    "typescript": "^4.4.4"
  },
  "bin": {
    "vuetify-ext": "./lib/cjs/cli/index.js"
  },
  "peerDependencies": {
    "vue": "^3.5.38",
    "vuetify": "^4.1.2"
  },
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "files": [
    "lib/"
  ],
  "dependencies": {
    "@feathersjs/client": "5.0.33",
    "@feathersjs/feathers": "5.0.33",
    "@feathersjs/rest-client": "5.0.33",
    "@feathersjs/socketio-client": "5.0.33",
    "@mdi/font": "^7.0.96",
    "@tiptap/extension-image": "^3.26.1",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/extension-table": "^3.26.1",
    "@tiptap/extension-table-cell": "^3.26.1",
    "@tiptap/extension-table-header": "^3.26.1",
    "@tiptap/extension-table-row": "^3.26.1",
    "@tiptap/extension-task-item": "^3.26.1",
    "@tiptap/extension-task-list": "^3.26.1",
    "@tiptap/extension-text-align": "^3.26.1",
    "@tiptap/extension-underline": "^3.26.1",
    "@tiptap/pm": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/vue-3": "^3.26.1",
    "@vuepic/vue-datepicker": "^5.4.0",
    "ace-builds": "^1.23.4",
    "apexcharts": "^3.41.0",
    "axios": "^1.5.0",
    "browser-image-compression": "^2.0.2",
    "ejs": "^3.1.9",
    "exceljs": "^4.3.0",
    "feathers-keycloak-connect-client": "^2.1.0",
    "file-saver": "^2.0.5",
    "gunshi": "^0.26.3",
    "hyphenation.de": "^0.2.1",
    "hyphenation.en-us": "^0.2.1",
    "js-base64": "^3.7.5",
    "katex": "^0.16.24",
    "keycloak-js": "^25.0.6",
    "moment": "^2.29.4",
    "moment-timezone": "0.5.45",
    "nested-property": "^4.0.0",
    "prettier": "^3.6.2",
    "roboto-fontface": "^0.10.0",
    "socket.io-client": "4.7.4",
    "vue3-ace-editor": "^2.2.2",
    "vue3-apexcharts": "^1.4.1",
    "vue3-editor": "^0.1.1",
    "vue3-google-map": "^0.15.0",
    "webfontloader": "^1.0.0",
    "webtex": "^0.20.0"
  }
